rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-scoped characters
    match /users/{userId}/characters/{characterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User-scoped series ordering preferences
    match /users/{userId}/seriesOrders/{seriesId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User preferences (including reading list)
    match /users/{userId}/preferences/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile/preferences if needed
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
